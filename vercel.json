{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run web:build",
  "outputDirectory": "apps/web/.next",
  "regions": [
    "lhr1"
  ],
  "git": {
    "deploymentEnabled": {
      "alpha1a-freeze-*": false,
      "alpha-freeze-*": false,
      "work/**": false
    }
  }
}
