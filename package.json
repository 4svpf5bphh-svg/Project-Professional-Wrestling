{
  "name": "project-professional-wrestling",
  "version": "0.0.11",
  "private": true,
  "description": "PPW SIM-0 headless persistent wrestling world simulation",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "test:core": "node dist/tests/run-tests.js",
    "test:lifecycle": "node dist/tests/run-lifecycle-tests.js",
    "test:competition": "node dist/tests/run-competition-tests.js",
    "test:booking": "node dist/tests/run-booking-tests.js",
    "test:programmes": "node dist/tests/run-programme-tests.js",
    "test:audience": "node dist/tests/run-audience-tests.js",
    "test:growth": "node dist/tests/run-growth-tests.js",
    "test:market-competition": "node dist/tests/run-market-competition-tests.js",
    "test:reputation": "node dist/tests/run-reputation-tests.js",
    "test:talent-trust": "node dist/tests/run-talent-trust-tests.js",
    "test:contract-trust": "node dist/tests/run-contract-trust-tests.js",
    "test:morale": "node dist/tests/run-morale-tests.js",
    "test:renewal-resistance": "node dist/tests/run-renewal-resistance-tests.js",
    "test:human-control": "node dist/tests/run-human-control-tests.js",
    "test:human-show": "node dist/tests/run-human-show-tests.js",
    "test:human-contracts": "node dist/tests/run-human-contract-tests.js",
    "test:human-booking": "node dist/tests/run-human-booking-tests.js",
    "test:human-championships": "node dist/tests/run-human-championship-tests.js",
    "test:human-routine": "node dist/tests/run-human-routine-tests.js",
    "test:state-schema": "node dist/tests/run-state-schema-tests.js",
    "test:id-allocation": "node dist/tests/run-id-allocation-tests.js",
    "test:application-ownership": "node dist/tests/run-application-ownership-tests.js",
    "test:application-commands": "node dist/tests/run-application-command-tests.js",
    "test:application-runtime": "node dist/tests/run-application-runtime-tests.js",
    "test:application-repository": "node dist/tests/run-application-repository-tests.js",
    "test:application-planning": "node dist/tests/run-application-planning-tests.js",
    "test:application-reservations": "node dist/tests/run-application-reservation-tests.js",
    "test:application-planning-compat": "node dist/tests/run-application-planning-compat-tests.js",
    "test:postgres-repository": "npm run build && node dist/tests/run-postgres-repository-tests.js && node dist/tests/run-postgres-reservation-tests.js",
    "test": "npm run build && npm run test:core && npm run test:lifecycle && npm run test:competition && npm run test:booking && npm run test:programmes && npm run test:audience && npm run test:growth && npm run test:market-competition && npm run test:reputation && npm run test:talent-trust && npm run test:contract-trust && npm run test:morale && npm run test:renewal-resistance && npm run test:human-control && npm run test:human-show && npm run test:human-contracts && npm run test:human-booking && npm run test:human-championships && npm run test:human-routine && npm run test:state-schema && npm run test:id-allocation && npm run test:application-ownership && npm run test:application-commands && npm run test:application-runtime && npm run test:application-repository && npm run test:application-planning && npm run test:application-reservations && npm run test:application-planning-compat",
    "sim": "npm run build && node dist/apps/sim-cli/src/index.js"
  },
  "dependencies": {
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
